# ---- Core
DATABASE_URL=postgres://localhost:5432/kaviar
# Public URL of this app (OAuth redirects + webhooks). Shopify webhooks need https (use a tunnel locally).
APP_URL=http://localhost:3000
# 32+ random chars: openssl rand -base64 32
SESSION_SECRET=
# 32 bytes, base64: openssl rand -base64 32  (encrypts Shopify/Meta tokens at rest)
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/sync
CRON_SECRET=

# ---- Shopify app (Dev Dashboard → your app → Settings)
# Redirect URL to allow-list: {APP_URL}/api/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_orders,read_all_orders,read_products,read_inventory,read_customers
# How far back the first sync goes
SHOPIFY_BACKFILL_DAYS=365

# ---- Meta app (developers.facebook.com → Facebook Login for Business)
# Valid OAuth redirect URI: {APP_URL}/api/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
META_SCOPES=ads_read,business_management
# Facebook Login for Business → Configurations → the configuration's ID (user access token, ads_read + business_management)
META_CONFIG_ID=
META_BACKFILL_DAYS=90
